# Access keys from web3forms.com. Each is tied to a destination inbox for a
# separate Web3Forms "form", so contact messages and newsletter signups land
# in separate places. Without a key set, the corresponding form runs in
# local demo mode (shows a success state but doesn't actually send anything).
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=
NEXT_PUBLIC_WEB3FORMS_NEWSLETTER_KEY=
